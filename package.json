{
  "name": "uapay-recurring",
  "version": "0.2.0",
  "description": "Recurring card billing for WayForPay and LiqPay: one interface, signed webhooks, server-side renewals and a dunning ladder, for products that cannot use Stripe.",
  "keywords": [
    "wayforpay",
    "liqpay",
    "recurring",
    "subscriptions",
    "billing",
    "payments",
    "ukraine",
    "webhook",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifetose/uapay-recurring.git"
  },
  "bugs": {
    "url": "https://github.com/lifetose/uapay-recurring/issues"
  },
  "homepage": "https://github.com/lifetose/uapay-recurring#readme",
  "author": "lifetose",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fix": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run type-check && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
